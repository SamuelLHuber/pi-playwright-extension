{
  "name": "pi-playwright-extension",
  "private": true,
  "version": "0.1.8",
  "description": "Headless Playwright browser extension for pi with persistent browser sessions and browser automation tools.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelLHuber/pi-playwright-extension.git"
  },
  "bugs": {
    "url": "https://github.com/SamuelLHuber/pi-playwright-extension/issues"
  },
  "homepage": "https://github.com/SamuelLHuber/pi-playwright-extension#readme",
  "keywords": [
    "pi",
    "playwright",
    "browser",
    "automation",
    "extension"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "postinstall": "playwright install chromium",
    "test": "tsx --test test/**/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "playwright": "^1.52.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@sinclair/typebox": "0.34.48",
    "@types/node": "22.20.5",
    "tsx": "^4.20.3",
    "typescript": "6.0.3"
  }
}
