{
  "name": "pi-playwright-extension",
  "private": true,
  "version": "0.1.3",
  "description": "Headless Playwright browser extension for pi with persistent browser sessions and browser automation tools.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelLHuber/pi-playwright-extension.git"
  },
  "bugs": {
    "url": "https://github.com/SamuelLHuber/pi-playwright-extension/issues"
  },
  "homepage": "https://github.com/SamuelLHuber/pi-playwright-extension#readme",
  "keywords": [
    "pi",
    "playwright",
    "browser",
    "automation",
    "extension"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./wallet": {
      "import": "./src/wallet-provider.ts"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.48",
    "playwright": "1.58.2",
    "viem": "2.48.11"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
